rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the caller is the authorized administrator
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'xylofydigitalcompany@gmail.com' &&
        request.auth.token.email_verified == true;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS COLLECTION
    // Public cannot read user profiles. Users can read their own profile. Admin can read/write all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can only create their own profile upon Google sign-in
      allow create: if isOwner(userId) && 
        request.resource.data.role == 'user' &&
        request.resource.data.freeCreditsRemaining == 5 &&
        request.resource.data.paidCreditsRemaining == 0 &&
        request.resource.data.isSuspended == false;
      // Users can only update non-privileged fields (e.g. displayName, phoneVerified)
      allow update: if (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'freeCreditsRemaining', 'paidCreditsRemaining', 'isSuspended', 'suspensionReason']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // PROPERTIES COLLECTION
    // Public can read only APPROVED listings.
    // Owners can read their own listings regardless of status.
    // Admins can read and manage all.
    match /properties/{propertyId} {
      allow read: if (resource.data.status == 'approved') || 
                     (isAuthenticated() && resource.data.contact.ownerId == request.auth.uid) || 
                     isAdmin();
      // Users sirf 'pending' listing submit kar saktay hain (self-approve / self-feature nahi)
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.contact.ownerId == request.auth.uid &&
        request.resource.data.featured == false &&
        request.resource.data.viewsCount == 0 &&
        !('approvedAt' in request.resource.data) &&
        !('approvedBy' in request.resource.data) &&
        request.resource.data.images.size() >= 3;
      allow update: if isAdmin()
        // Owner sirf pehle se approved listing ko pause/resume kar sakta hai
        || (isOwner(resource.data.contact.ownerId) &&
            'approvedAt' in resource.data &&
            resource.data.status in ['approved', 'paused'] &&
            request.resource.data.status in ['approved', 'paused'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        // Koi bhi visitor sirf views +1 kar sakta hai
        || (resource.data.status == 'approved' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
            request.resource.data.viewsCount == resource.data.viewsCount + 1);
      allow delete: if (isOwner(resource.data.contact.ownerId) && resource.data.status != 'approved') || isAdmin();
    }

    // PAYMENTS COLLECTION
    // Users can create payment requests for package Rs 500 (14 credits).
    // Users can read only their own payments.
    // Only Admin can approve or reject payments and change status.
    match /payments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amountPKR == 500 &&
        request.resource.data.creditsCount == 14;
      allow update: if isAdmin(); // Users cannot modify their submitted payment
      allow delete: if isAdmin();
    }

    // WEBSITE REVIEWS COLLECTION
    // Public can read approved reviews. Users can submit pending reviews. Admin moderates.
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved') || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.featured == false &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // SITE SETTINGS COLLECTION
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMIN AUDIT LOGS
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.performedBy == request.auth.token.email;
      allow update, delete: if false; // Immutable audit log
    }

    // VIEW EVENTS (Analytics deduplication)
    match /viewEvents/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
